{
  "expo": {
    "name": "七刷错题本",
    "slug": "qishua_wrongbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qishuawrongbook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.okshuxue.qishuawrongbook",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF0000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.okshuxue.qishua_wrongbook",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow camera access to capture mistake photos.",
          "photosPermission": "Allow photo library access to pick mistake photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan worksheet QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "七刷错题需要使用麦克风录制你的复做讲解。",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf89374a-dfbf-43b4-83df-678ed437cc24"
      }
    }
  }
}
